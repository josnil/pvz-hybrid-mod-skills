<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「奶龙僵尸」Mod 的托管运行时程序集。

    与 runtime_src / runtime_src_plant / runtime_src_zombie / runtime_src_zombie_super_gatling /
    runtime_src_zombie_sunflower_queen 是**六个独立工程**：每个 .pmod 都必须自带一份路径
    恰好为 Runtime/ModAssembly.dll 的程序集，且各自的 runtimeEntryType 不同
    ⇒ 刻意不共用，前面五份已验证的产物字节完全不受影响。

    本工程不需要 runtime_shared/*.cs：
      · 不做发射 ⇒ 不需要 GatlingVolleyCore；
      · 自制 .dat 的「动画静止」修法在本目录内的 NaiLongLocalRender.cs
        （与 runtime_shared/AnimeSpriteLocalRender.cs 逻辑等价，只是 SkinDataToken
         是 const 且值不同 ⇒ 不能共用同一份源）。

    刻意不用 Godot.NET.Sdk（要联网还原 NuGet + 跑源码生成器）：本入口只用到
    Godot 普通 API（Engine / SceneTree / Node / Callable / GD / Time / GodotObject /
    Godot.Collections）和游戏程序集里的公开成员。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ModAssembly</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GodotRefDir Condition="'$(GodotRefDir)' == ''">D:\zzz\植物大战僵尸杂交版0.28.1\植物大战僵尸杂交重制版\data_PlantsVsZombies_windows_x86_64</GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      离线校验脚本（check_*.cs 这类「文件级应用」带顶级语句）不能被当库成员编译，
      否则 CS8805「使用顶级语句的程序必须是可执行文件」。
    -->
    <Compile Remove="check_*.cs" />
    <None Include="check_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false：26MB 的游戏程序集不进输出，运行时由引擎自己那份解析 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
