# --- 本机路径适配（自动注入；换机器只改 tools/_env.py）---
import os as _os
import sys as _sys

_TOOLS = _os.path.dirname(_os.path.abspath(__file__))
while not _os.path.isfile(_os.path.join(_TOOLS, "_env.py")):
    _parent = _os.path.dirname(_TOOLS)
    if _parent == _TOOLS:
        break
    _TOOLS = _parent
if _TOOLS not in _sys.path:
    _sys.path.insert(0, _TOOLS)
_PIPE = _os.path.join(_TOOLS, 'plant')
if _os.path.isdir(_PIPE) and _PIPE not in _sys.path:
    _sys.path.insert(0, _PIPE)

from _env import (  # noqa: E402
    GAME, UNPACK, CLASSIC, MODS, USER_DATA_DIR, PY, WORKSPACE, REF_DIR,
    require_ref_dir, require_classic, ensure_mods, unpack_status, describe,
)
try:  # 从属脚本：向上找 _gen.py 定位本流水线的工作区
    from _gen import MOD_WORKSPACE  # noqa: F401,E402
except ImportError:
    MOD_WORKSPACE = None
# --- 适配块结束 ---
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「超级机枪射手」植物 Mod 的托管运行时程序集。

    与 runtime_src（地图 Mod 那份）是**两个独立工程**：每个 .pmod 都必须自带一份
    路径恰好为 Runtime/ModAssembly.dll 的程序集，且各自的 runtimeEntryType 不同，
    所以刻意不共用 —— 这样地图那份已验证的产物字节不受影响。

    同样刻意不用 Godot.NET.Sdk（要联网还原包 + 源码生成器）：本入口只用到
    Godot 普通 API（Engine / SceneTree / Node / Time / RandomNumberGenerator）
    和游戏程序集里的公开成员，不碰靠源码生成器产生的东西（SignalName / MethodName 等）。
    `OnFireVolley` 是**游戏自己声明的 C# event**（FireComponent.cs:673），可以直接 += / -=。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ModAssembly</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!--
      注意：两台机/两处拷贝的目录名不同（实测）：
        <本机游戏本体>\data_PlantsVsZombies_windows_x86_64
        <本机游戏本体>\data_PlantsVsZombies_windows_x86_64
      本机由 build_runtime.py 以 -p:GodotRefDir=... 传入（值来自 tools/_env.py 推导）。
    -->
    <GodotRefDir Condition="'$(GodotRefDir)' == ''"></GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      离线校验脚本（check_*.cs 这类「文件级应用」带顶级语句）不能被当库成员编译，
      否则 CS8805「使用顶级语句的程序必须是可执行文件」。
    -->
    <Compile Remove="check_*.cs" />
    <None Include="check_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      植物 / 僵尸**共用**同一份「射击判定核心」源文件（单一真源）：
      runtime_shared/GatlingVolleyCore.cs。Link 让它以虚拟文件名出现在工程里。
    -->
    <Compile Include="..\runtime_shared\GatlingVolleyCore.cs" Link="GatlingVolleyCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false：26MB 的游戏程序集不进输出，运行时由引擎自己那份解析 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
