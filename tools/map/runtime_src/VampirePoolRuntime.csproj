# --- 本机路径适配（自动注入；换机器只改 tools/_env.py）---
import os as _os
import sys as _sys

_TOOLS = _os.path.dirname(_os.path.abspath(__file__))
while not _os.path.isfile(_os.path.join(_TOOLS, "_env.py")):
    _parent = _os.path.dirname(_TOOLS)
    if _parent == _TOOLS:
        break
    _TOOLS = _parent
if _TOOLS not in _sys.path:
    _sys.path.insert(0, _TOOLS)
_PIPE = _os.path.join(_TOOLS, 'map')
if _os.path.isdir(_PIPE) and _PIPE not in _sys.path:
    _sys.path.insert(0, _PIPE)

from _env import (  # noqa: E402
    GAME, UNPACK, CLASSIC, MODS, USER_DATA_DIR, PY, WORKSPACE, REF_DIR,
    require_ref_dir, require_classic, ensure_mods, unpack_status, describe,
)
try:  # 从属脚本：向上找 _gen.py 定位本流水线的工作区
    from _gen import MOD_WORKSPACE  # noqa: F401,E402
except ImportError:
    MOD_WORKSPACE = None
# --- 适配块结束 ---
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「吸血鬼屋泳池」Mod 的托管运行时程序集。
    刻意不用 Godot.NET.Sdk（那要联网还原 Godot SDK 包 + 源码生成器）：
    本入口只用到 Godot 的普通 API（Engine / SceneTree / Sprite2D / Image / ImageTexture /
    Callable），不碰任何靠源码生成器产生的成员（SignalName / MethodName / 信号事件等），
    所以直接引用游戏自带的 GodotSharp.dll + PlantsVsZombies.dll 就够了。
    信号用字符串名 "process_frame" + 自己缓存的 Callable，避免依赖生成的事件。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ModAssembly</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- 引用目录：默认取与解包源码同源的那套安装；可由 -p:GodotRefDir=... 覆盖 -->
    <GodotRefDir Condition="'$(GodotRefDir)' == ''"></GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      本目录下的离线校验脚本（如 check_entry.cs）带顶级语句，是「文件级应用」而不是库成员。
      SDK 默认会把 **/*.cs 全捞进编译 → CS8805「使用顶级语句的程序必须是可执行文件」。
      ⚠️ 新增工具脚本时务必一并排除，否则 build_runtime.py 会编译失败。
    -->
    <Compile Remove="check_*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <None Include="check_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false：不要把 26MB 的游戏程序集复制进输出，运行时由引擎自己那份解析 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
